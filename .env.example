# ── Banco (docker-compose local) ─────────────────────────────────────────────
DATABASE_URL="postgresql://peopleflow:peopleflow@localhost:5432/peopleflow?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_CORS_ORIGINS="http://localhost:3000"

# JWT RS256 — gere o par com:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# e cole aqui em base64 (uma linha): base64 -w0 jwt-private.pem
JWT_PRIVATE_KEY_BASE64=""
JWT_PUBLIC_KEY_BASE64=""
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Storage (MinIO local; Supabase/S3 em produção — ADR-009) ─────────────────
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="peopleflow"
STORAGE_SECRET_KEY="peopleflow"
STORAGE_BUCKET="peopleflow"
