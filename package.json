{
  "name": "peopleflow",
  "private": true,
  "version": "0.1.0",
  "description": "PeopleFlow Platform — HCM multi-tenant (DP + RH)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @peopleflow/database db:generate",
    "db:migrate": "pnpm --filter @peopleflow/database db:migrate",
    "db:seed": "pnpm --filter @peopleflow/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
