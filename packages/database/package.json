{
  "name": "@peopleflow/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migrations e seeds da plataforma (doc 04)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@peopleflow/config": "workspace:*",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
